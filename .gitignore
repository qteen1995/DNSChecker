# ---- 打包产物 ----
build/
dist/
*.spec

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 截图中间产物 ----
# make_shots.py 早期版本抓的是全屏像素（3 张 2MB 的同一张桌面图），
# 不是交付内容。真正的界面图是 demo_*.png，那些要进库。
shot_*.png

# ---- 运行期文件 ----
# 配置与崩溃日志落在 %USERPROFILE%\.dnschecker\，不会出现在这里，
# 但手动跑脚本时可能在仓库根目录留下日志。
*.log
